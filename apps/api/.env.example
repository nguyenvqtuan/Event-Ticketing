# Copy to .env and adjust:  cp apps/api/.env.example apps/api/.env
#
# Every variable the API reads is listed here. The schema in
# src/config/env.schema.ts is authoritative — it validates these at bootstrap
# and the app refuses to start if any required value is missing or malformed.

# ---- Required -------------------------------------------------------------
# Postgres connection string. No default on purpose: a wrong default would
# silently point a deployment at the wrong database.
# The value below matches the docker-compose service arriving in TICK-3.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_ticketing

# ---- Optional (defaults shown) --------------------------------------------
# development | test | production
NODE_ENV=development

# HTTP port for the API (the web client runs on 3001).
PORT=3000

# error | warn | log | debug | verbose
LOG_LEVEL=log

# How long a seat hold survives before expiring, in seconds (15 minutes).
RESERVATION_TTL_SECONDS=900

# Browser origin allowed to call this API.
CORS_ORIGIN=http://localhost:3001
