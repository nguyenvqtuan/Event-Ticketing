# Copy to .env.local and adjust:  cp apps/web/.env.example apps/web/.env.local
#
# Two variables, because this app calls the API from two places and they are
# not always the same address. See apps/web/src/lib/api/config.ts.

# The address a BROWSER uses. Inlined into the bundle at build time, so it must
# be reachable from the user's machine — and it must be set at build time, not
# just at run time.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional. The address the SERVER uses, for server components and route
# handlers. On a container network this is often an internal name the browser
# could never resolve. Falls back to NEXT_PUBLIC_API_URL when unset, so a
# single-address deployment configures only the one above.
# API_URL=http://api:3000
